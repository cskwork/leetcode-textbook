{:paths ["src" "spec"]
 :mvn/local-repo ".swarmforge/m2"
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        babashka/fs {:mvn/version "0.5.34"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        speclj/speclj {:mvn/version "3.13.0"}}
 :aliases
 {:spec {:main-opts ["-m" "speclj.main" "-c" "spec"]}
  :spec-structure {:extra-deps
                   {io.github.unclebob/speclj-structure-check
                    {:git/url "https://github.com/unclebob/speclj-structure-check.git"
                     :git/sha "6bdc1621e96bcf90f84849e2c48d750ae6bc7297"}}
                   :main-opts ["-m" "speclj-structure-check.core" "spec"]}
  :cov {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
        :main-opts ["-m" "speclj.cloverage" "--" "-p" "src" "-s" "spec" "--lcov"]}
  :mutate {:extra-deps
           {io.github.unclebob/clj-mutate
            {:git/url "https://github.com/unclebob/clj-mutate.git"
             :git/sha "e27dd5df63c4efdd66438587d1c5f49e73661b69"}
            org.clojure/tools.reader {:mvn/version "1.4.2"}}
           :main-opts ["-m" "clj-mutate.core"]}
  :crap {:extra-deps
         {io.github.unclebob/crap4clj
          {:git/url "https://github.com/unclebob/crap4clj.git"
           :git/sha "e6e0312fb9fe25cb8bdc55557d60c0e1c0568fb9"}}
         :main-opts ["-m" "crap4clj.core"]}
  :dry {:extra-deps
        {io.github.unclebob/dry4clj
         {:git/url "https://github.com/unclebob/dry4clj.git"
          :git/sha "5994ef2bcaaae8d12bcd0afb4f091ae09083228c"}}
        :main-opts ["-m" "dry4clj.core"]}}}
